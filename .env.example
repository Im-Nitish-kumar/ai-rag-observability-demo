# Copy this file to .env and replace every placeholder with your own values.
# NEVER commit .env or real API keys/tokens to GitHub.

# OpenObserve connection (cloud or self-hosted)
OPENOBSERVE_URL=https://api.openobserve.ai/
OPENOBSERVE_ORG=your_org_slug
OPENOBSERVE_AUTH_TOKEN=Basic <base64-of-your-email-and-password>

# LLM provider credential
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Service names used to identify traces
LANGCHAIN_SERVICE_NAME=langchain-rag-demo
LLAMAINDEX_SERVICE_NAME=llamaindex-rag-demo

# Frontend/backend configuration
BACKEND_URL=http://localhost:8001
FRONTEND_URL=http://localhost:3000

# Optional local debugging
DEBUG=false
